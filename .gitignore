# --- Windows build artefacts -------------------------------------------
# The compiled DLL at the repository ROOT is deliberately NOT ignored:
# the node files live at the root, so a plain "git clone" into custom_nodes
# gives Windows users a working node with no extra steps. It is ~100 KB.
# Only the build directory copy and intermediate output are excluded here.
Windows/*.obj
Windows/*.exp
Windows/*.lib
Windows/*.pdb
Windows/*.ilk
Windows/*.dll

# --- Linux kernel module build artefacts --------------------------------
Device/*.o
Device/*.ko
Device/*.mod
Device/*.mod.c
Device/*.mod.o
Device/Module.symvers
Device/modules.order
Device/.*.cmd
Device/.tmp_versions/

# --- Entropy pools ------------------------------------------------------
# Multi-GB binaries have no business in git history. Ship them as release
# assets; generate small ones locally with tools/generate_pool.py.
*.dat

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
